# ================== LLM ==================
# Active provider: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.7

# Ollama (100% local) - the model must be pulled first: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (optional, your own key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional, your own key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ================ WHISPER ================
# tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# int8 (CPU/GPU, light) | float16 (GPU) | float32
WHISPER_COMPUTE_TYPE=int8

# ================ OUTPUT =================
OUTPUT_DIR=output
# Language of the generated content (free text, e.g. italiano, english, español)
OUTPUT_LANGUAGE=english
LOG_LEVEL=INFO
